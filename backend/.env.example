# Environment variables for Invoice OCR API
# Copy this file to .env and fill in your actual values

# Optional for SaaS: PostgreSQL database. In local MVP, the backend falls back to SQLite.
DATABASE_URL=postgresql://invoice_user:invoice_password@localhost:5432/invoice_rag_os

# OCR remains local. Auto extraction uses the configured provider.
# Invoice extraction only. legacy preserves the previous chunking; layout keeps OCR geometry.
RAG_CHUNKING_MODE=legacy
# Invoice extraction only; chatbot embeddings and stores are independent.
# Both options require model weights already cached locally. CPU inference only.
RAG_EMBEDDING_MODEL=minilm
# Alternative for explicit evaluation: RAG_EMBEDDING_MODEL=bge-m3
INVOICE_LLM_PROVIDER=local
GROQ_API_KEY=
GROQ_INVOICE_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_OUTPUT_TOKENS=1800
# Set INVOICE_LLM_PROVIDER=groq after configuring the server-side key.
# Never use a VITE_ variable for this key.
OLLAMA_OCR_MODEL=glm-ocr:q8_0
OLLAMA_INVOICE_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_OCR_TIMEOUT_SECONDS=180
OLLAMA_OCR_MAX_IMAGE_SIDE=1600

# Application configuration
UPLOAD_FOLDER=data/uploads
INVOICE_STORAGE_FOLDER=data/invoice_storage/documents
DOCUMENT_STORAGE_FOLDER=data/document_ai/documents
RAG_STORAGE_FOLDER=data/rag_storage/documents
YOLO_MODEL_PATH=models/extraction/best.pt
AUTH_DB_PATH=data/auth.sqlite3
FATURA_DATASET_ZIP=C:\Users\maiss\Downloads\FATURA.zip
FATURA_DATASET_DB_PATH=data/fatura_dataset.sqlite3
TESSDATA_DIR=backend/tessdata
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=png,jpg,jpeg,tiff,bmp,webp,pdf

# Optional: Development settings
DEBUG=false
LOG_LEVEL=info

# Optional: Redis (if using caching)
# REDIS_URL=redis://localhost:6379/0
## Local OCR: use paddle after installing its dependencies and model weights.
OCR_TEXT_ENGINE=tesseract
PADDLE_TEXT_SIZE=small
PADDLE_TEXT_ARABIC=true
