# Environment variables for Invoice OCR API
# Copy this file to .env and fill in your actual values

# Optional for SaaS: PostgreSQL database. In local MVP, the backend falls back to SQLite.
DATABASE_URL=postgresql://invoice_user:invoice_password@localhost:5432/invoice_rag_os

# Required for cloud LLM extraction. Keep empty if you only use local/fallback extraction.
GEMINI_API_KEY=your_gemini_api_key_here

# Application configuration
UPLOAD_FOLDER=data/uploads
INVOICE_STORAGE_FOLDER=data/invoice_storage/documents
DOCUMENT_STORAGE_FOLDER=data/document_ai/documents
RAG_STORAGE_FOLDER=data/rag_storage/documents
YOLO_MODEL_PATH=models/extraction/best.pt
AUTH_DB_PATH=data/auth.sqlite3
FATURA_DATASET_ZIP=C:\Users\maiss\Downloads\FATURA.zip
FATURA_DATASET_DB_PATH=data/fatura_dataset.sqlite3
TESSDATA_DIR=backend/tessdata
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=png,jpg,jpeg,tiff,bmp,webp,pdf

# Optional: Development settings
DEBUG=false
LOG_LEVEL=info

# Optional: Redis (if using caching)
# REDIS_URL=redis://localhost:6379/0
